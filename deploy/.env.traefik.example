# Copy to private .env.production. Replace secrets before deployment.
DEPLOY_PROXY=traefik
POSTGRES_PASSWORD=replace-with-a-random-password
CONTAINER_DATABASE_URL=postgresql://boardroom:replace-with-a-random-password@postgres:5432/boardroom
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SITE_ADDRESS=note.vertexfilms.ca
APP_ORIGIN=https://note.vertexfilms.ca
TRAEFIK_NETWORK=reverse-proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=vertexfilms
# Confirmed static Traefik address on the reverse-proxy network.
TRUST_PROXY=172.19.0.7/32
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
