{
  "name": "boardroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remote-dev.ps1",
    "build": "tsc --noEmit && vite build --configLoader runner && node scripts/build-server.mjs",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "preview": "vite preview",
    "dev:api": "node --env-file=.env --import tsx server/index.ts",
    "test:model": "node --import tsx --test tests/model.test.ts",
    "test:browser": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "ops": "node --env-file-if-exists=.release.env scripts/ops.mjs",
    "test:ops": "node scripts/test-ops.mjs"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "file-type": "^22.1.1",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
