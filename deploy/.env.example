# Copy to a private file, e.g. .env.production. No production service is launched automatically.
POSTGRES_PASSWORD=replace-with-a-random-password
# Percent-encode special characters in the password for this URL.
CONTAINER_DATABASE_URL=postgresql://boardroom:replace-with-a-random-password@postgres:5432/boardroom
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SITE_ADDRESS=localhost
APP_ORIGIN=https://localhost:8443
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
