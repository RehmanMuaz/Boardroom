POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://boardroom:replace-with-a-long-random-password@127.0.0.1:5432/boardroom
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_ORIGIN=http://localhost:5173
API_PORT=3001
COOKIE_SECURE=false
ASSET_DIR=data/assets
REQUIRE_EMAIL_VERIFICATION=false
# Configure SMTP to enable verification, recovery and invitation delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Use only behind a known reverse proxy; never use a numeric hop count.
TRUST_PROXY=
